* Measure LELO_EX
.control

load {cicname}.raw

echo "MEAS_START"

let iref = v(vi_input)
let ibn = -i(v0)
let k = ibn/iref
let acc = abs(ibn - k*iref)/(k*iref)
meas tran ibns_20u find ibn at=5n
meas tran k find k at=5n
meas tran acc find acc at=5n
meas tran vgs_m1 find v(ibps_5u) at=5n

echo "MEAS_END"
.endc
